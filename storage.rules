rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures: world-readable to signed-in users, writable only by the owner, images under 2 MB.
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
    // Everything else is denied by default (chat attachments are not built yet).
  }
}
